# Copy to .env on the deployment server and chmod 600 .env.
# Set unique deployment credentials before starting; never commit .env.
# Values with spaces or # must be quoted. Values are literal, not shell code.
ALGO_USERNAME=''
ALGO_PASSWORD=''
# ALGO_PASSWORD_HASH=''  # Optional alternative; a nonempty hash takes precedence.
# ALGO_ROOT='/path/to/unzips'
ALGO_HOST=0.0.0.0
ALGO_PORT=8080
ALGO_MAX_TESTS=8
ALGO_CPU_THREADS=2
